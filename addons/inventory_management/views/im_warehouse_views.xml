<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_warehouse_view_list" model="ir.ui.view">
        <field name="name">im.warehouse.list</field>
        <field name="model">im.warehouse</field>
        <field name="arch" type="xml">
            <list string="Warehouses">
                <field name="name"/>
                <field name="address"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="im_warehouse_view_form" model="ir.ui.view">
        <field name="name">im.warehouse.form</field>
        <field name="model">im.warehouse</field>
        <field name="arch" type="xml">
            <form string="Warehouse">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                        <field name="capacity"/>
                        <field name="email"/>
                    </group>
                    <notebook>
                        <page string="Locations">
                            <field name="location_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="zone_bin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_im_warehouse" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">im.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_im_warehouse"
        name="Warehouses"
        parent="menu_inventory_management_root"
        action="action_im_warehouse"
        sequence="30"/>
</odoo>
