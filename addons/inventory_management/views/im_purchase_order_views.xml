<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_purchase_order_view_list" model="ir.ui.view">
        <field name="name">im.purchase.order.list</field>
        <field name="model">im.purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders">
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <field name="order_date"/>
                <field name="state"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record id="im_purchase_order_view_form" model="ir.ui.view">
        <field name="name">im.purchase.order.form</field>
        <field name="model">im.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'"/>
                    <button name="action_receive_all" string="Receive All" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Mark Done" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                            <field name="expected_date"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Moves">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="dest_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_im_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">im.purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_im_purchase_order"
        name="Purchase Orders"
        parent="menu_inventory_management_root"
        action="action_im_purchase_order"
        sequence="50"/>
</odoo>
