<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_quant_view_list" model="ir.ui.view">
        <field name="name">im.quant.list</field>
        <field name="model">im.quant</field>
        <field name="arch" type="xml">
            <list string="Stock Quants" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="action_im_quant" model="ir.actions.act_window">
        <field name="name">Stock Quants</field>
        <field name="res_model">im.quant</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_im_quant"
        name="Stock Quants"
        parent="menu_inventory_management_root"
        action="action_im_quant"
        sequence="70"/>
</odoo>
