<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_shipment_view_list" model="ir.ui.view">
        <field name="name">im.shipment.list</field>
        <field name="model">im.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments">
                <field name="sale_order_id"/>
                <field name="warehouse_id"/>
                <field name="shipment_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="im_shipment_view_form" model="ir.ui.view">
        <field name="name">im.shipment.form</field>
        <field name="model">im.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_deliver_all" string="Deliver All" type="object" invisible="status != 'confirmed'"/>
                    <button name="action_done" string="Mark Done" type="object" invisible="status != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="status in ('done', 'cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="warehouse_id"/>
                        <field name="shipment_date"/>
                    </group>
                    <notebook>
                        <page string="Moves">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="source_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_im_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">im.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_im_shipment"
        name="Shipments"
        parent="menu_im_sales_group"
        action="action_im_shipment"
        sequence="20"/>
</odoo>
