<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_sale_order_view_list" model="ir.ui.view">
        <field name="name">im.sale.order.list</field>
        <field name="model">im.sale.order</field>
        <field name="arch" type="xml">
            <list string="Sale Orders">
                <field name="customer_id"/>
                <field name="warehouse_id"/>
                <field name="order_date"/>
                <field name="state"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record id="im_sale_order_view_form" model="ir.ui.view">
        <field name="name">im.sale.order.form</field>
        <field name="model">im.sale.order</field>
        <field name="arch" type="xml">
            <form string="Sale Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'"/>
                    <button name="action_deliver_all" string="Deliver All" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Mark Done" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                            <field name="expected_date"/>
                            <field name="amount_total"/>
                            <field name="shipment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_im_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">im.sale.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_im_sale_order"
        name="Sale Orders"
        parent="menu_im_sales_group"
        action="action_im_sale_order"
        sequence="10"/>
</odoo>
