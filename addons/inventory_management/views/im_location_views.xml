<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_location_view_list" model="ir.ui.view">
        <field name="name">im.location.list</field>
        <field name="model">im.location</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="type"/>
                <field name="zone_bin"/>
                <field name="is_default_receiving"/>
                <field name="is_default_shipping"/>
            </list>
        </field>
    </record>

    <record id="im_location_view_form" model="ir.ui.view">
        <field name="name">im.location.form</field>
        <field name="model">im.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="warehouse_id"/>
                        <field name="type"/>
                        <field name="zone_bin"/>
                        <field name="is_default_receiving"/>
                        <field name="is_default_shipping"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_im_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">im.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_im_location"
        name="Locations"
        parent="menu_im_inventory_group"
        action="action_im_location"
        sequence="20"/>
</odoo>
