<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_im" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.im</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_role"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_list_inherit_im" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.im</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="partner_role" optional="show"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_search_inherit_im" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.im</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="partner_role"/>
                <filter string="Suppliers" name="filter_is_supplier" domain="[('is_supplier', '=', True)]"/>
                <filter string="Customers" name="filter_is_customer" domain="[('is_customer', '=', True)]"/>
            </field>
        </field>
    </record>
</odoo>
