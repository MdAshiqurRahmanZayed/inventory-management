<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_purchase_order" model="ir.sequence">
            <field name="name">PO Sequence</field>
            <field name="code">im.purchase.order</field>
            <field name="prefix">PO-</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_stock_move" model="ir.sequence">
            <field name="name">Stock Move Sequence</field>
            <field name="code">im.move</field>
            <field name="prefix">SM-</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_sale_order" model="ir.sequence">
            <field name="name">SO Sequence</field>
            <field name="code">im.sale.order</field>
            <field name="prefix">SO-</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_shipment" model="ir.sequence">
            <field name="name">Shipment Sequence</field>
            <field name="code">im.shipment</field>
            <field name="prefix">SH-</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
