<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_management" model="ir.module.category">
        <field name="name">Inventory Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_stock_role" model="res.groups.privilege">
        <field name="name">Role</field>
        <field name="category_id" ref="module_category_inventory_management"/>
    </record>

    <record id="group_stock_viewer" model="res.groups">
        <field name="name">Stock Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_role"/>
        <field name="comment">Read-only access to products, stock, orders, shipments, moves and the dashboard.</field>
    </record>

    <record id="group_stock_user" model="res.groups">
        <field name="name">Stock User</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_role"/>
        <field name="implied_ids" eval="[(4, ref('group_stock_viewer'))]"/>
        <field name="comment">Everything a Viewer can, plus draft purchase/sales orders, create shipments, create and confirm moves, and close alerts.</field>
    </record>

    <record id="group_stock_manager" model="res.groups">
        <field name="name">Stock Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_role"/>
        <field name="implied_ids" eval="[(4, ref('group_stock_user')), (4, ref('role_management.group_role_manager'))]"/>
        <field name="comment">Everything a User can, plus confirm purchase orders, run adjustments, manage products/suppliers/customers/warehouses/locations, and read the API log.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
