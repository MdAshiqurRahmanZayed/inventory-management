<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_im_stock_report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="warehouse">
                <t t-set="report_lines" t-value="report_data[warehouse.id][0]"/>
                <t t-set="report_total" t-value="report_data[warehouse.id][1]"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Stock Report</h2>
                        <h4>
                            <span t-field="warehouse.name"/>
                        </h4>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>SKU</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="report_lines" t-as="line">
                                    <td>
                                        <span t-esc="line['product'].name"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['product'].sku"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['quantity']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'%.2f' % line['value']"/>
                                    </td>
                                </tr>
                                <tr t-if="not report_lines">
                                    <td colspan="4" class="text-center">No stock on hand.</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="'%.2f' % report_total"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_im_stock_report" model="ir.actions.report">
        <field name="name">Stock Report</field>
        <field name="model">im.warehouse</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inventory_management.report_im_stock_report_document</field>
        <field name="report_file">inventory_management.report_im_stock_report_document</field>
        <field name="binding_model_id" ref="model_im_warehouse"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
