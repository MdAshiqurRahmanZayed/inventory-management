<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_list_role_management" model="ir.ui.view">
        <field name="name">res.users.list.role.management</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Users">
                <field name="avatar_128" widget="image" class="oe_avatar" options="{'size': [24, 24]}"/>
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="res_users_view_form_role_management" model="ir.ui.view">
        <field name="name">res.users.form.role.management</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="User Role">
                <sheet>
                    <field name="avatar_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="User name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="login"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Roles">
                            <field name="group_ids" widget="many2many_tags" domain="[('privilege_id.category_id', '!=', False)]"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
