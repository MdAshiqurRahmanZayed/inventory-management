<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- API log: an MCP User reads only their own rows; an MCP Admin reads all. -->
    <record id="rule_im_api_log_user_own_read" model="ir.rule">
        <field name="name">API log: MCP User reads only their own rows</field>
        <field name="model_id" ref="model_im_api_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_im_api_log_admin_read" model="ir.rule">
        <field name="name">API log: MCP Admin reads all rows</field>
        <field name="model_id" ref="model_im_api_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
