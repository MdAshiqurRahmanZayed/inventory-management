<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- API log: a Stock User reads only their own rows; Manager reads all (see group_stock_manager.perm_read on im.api.log). -->
    <record id="rule_im_api_log_user_own_read" model="ir.rule">
        <field name="name">API log: User reads only their own rows</field>
        <field name="model_id" ref="model_im_api_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('inventory_management.group_stock_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_im_api_log_manager_read" model="ir.rule">
        <field name="name">API log: Manager reads all rows</field>
        <field name="model_id" ref="model_im_api_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('inventory_management.group_stock_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
