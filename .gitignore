odoo-data/
db-data/
postgres-data/

# Node (if odoo-mcp or tooling adds a JS/TS toolchain later)
node_modules/
npm-debug.log*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
