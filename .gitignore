# Odoo config (local secrets — copy odoo.conf.example to odoo.conf)
odoo.conf
!odoo.conf.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/
.venv/
venv/
env/
